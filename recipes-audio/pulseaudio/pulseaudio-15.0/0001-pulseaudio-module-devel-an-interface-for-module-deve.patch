From a4b6edebe9fff447a4414a3b4f2a1286e195098a Mon Sep 17 00:00:00 2001
From: Guodong Hu <guodhu@codeaurora.org>
Date: Thu, 15 Apr 2021 15:15:13 +0800
Subject: [PATCH] pulseaudio-module-devel: an interface for module development

pulseaudio-module-devel is as an interface for pulseaudio module
development, which contains necessary headers for modules.

Signed-off-by: Guodong Hu <guodhu@codeaurora.org>
---
 meson.build                   | 11 +++++
 pulseaudio-module-devel.pc.in | 11 +++++
 src/pulsecore/meson.build     | 97 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 119 insertions(+)
 create mode 100644 pulseaudio-module-devel.pc.in

diff --git a/meson.build b/meson.build
index dd90bf2..7c71923 100644
--- a/meson.build
+++ b/meson.build
@@ -66,6 +66,7 @@ localedir = join_paths(prefix, get_option('localedir'))
 localstatedir = join_paths(prefix, get_option('localstatedir'))
 sysconfdir = join_paths(prefix, get_option('sysconfdir'))
 privlibdir = join_paths(libdir, 'pulseaudio')
+includedirpulsecore = join_paths(includedir, 'pulsecore')
 
 alsadatadir = get_option('alsadatadir')
 if alsadatadir == ''
@@ -718,6 +719,14 @@ subdir('vala')
 # Now generate config.h from everything above
 configure_file(output : 'config.h', configuration : cdata)
 
+# Now generate pulsecore-config.h from everything above
+configure_file(
+  output : 'pulsecore-config.h',
+  configuration : cdata,
+  install : true,
+  install_dir : includedirpulsecore
+)
+
 # pkg-config files
 
 pc_cdata = configuration_data()
@@ -744,6 +753,8 @@ if glib_dep.found()
   pc_files += 'libpulse-mainloop-glib.pc'
 endif
 
+pc_files += 'pulseaudio-module-devel.pc'
+
 foreach file : pc_files
   configure_file(
     input : file + '.in',
diff --git a/pulseaudio-module-devel.pc.in b/pulseaudio-module-devel.pc.in
new file mode 100644
index 0000000..59a8190
--- /dev/null
+++ b/pulseaudio-module-devel.pc.in
@@ -0,0 +1,11 @@
+prefix=@prefix@
+exec_prefix=@exec_prefix@
+libdir=@libdir@
+includedir=@includedir@
+modlibexecdir=@modlibexecdir@
+
+Name: pulseaudio-module-devel
+Description: PulseAudio Module Development Interface
+Version: @PACKAGE_VERSION@
+Libs: -L${libdir} -L${libdir}/pulseaudio -L${modlibexecdir} -lpulsecommon-@PA_MAJORMINOR@ -lpulsecore-@PA_MAJORMINOR@ -lprotocol-native
+Libs.private:
diff --git a/src/pulsecore/meson.build b/src/pulsecore/meson.build
index 99a702e..2c5db68 100644
--- a/src/pulsecore/meson.build
+++ b/src/pulsecore/meson.build
@@ -58,57 +58,144 @@ libpulsecore_sources = [
 ]
 

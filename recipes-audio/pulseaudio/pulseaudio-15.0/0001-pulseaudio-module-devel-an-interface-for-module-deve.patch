+
+libpulsecore_filter_headers = [
+  'filter/biquad.h',
+  'filter/crossover.h',
+  'filter/lfe-filter.h',
 ]
 
 if get_option('database') == 'tdb'
@@ -204,6 +291,16 @@ libpulsecore = shared_library('pulsecore-' + pa_version_major_minor,
 
 libpulsecore_dep = declare_dependency(link_with: libpulsecore)
 
+install_headers(
+  libpulsecore_headers,
+  subdir : 'pulsecore'
+)
+
+install_headers(
+  libpulsecore_filter_headers,
+  subdir : 'pulsecore/filter'
+)
+
 # Internal libraries for modules
 # TODO: understand 'c_args' and 'dependencies' better, maybe we can remove some
 
-- 

From 724cbecb7e1981067bbdb9bb8a2b54e0349324d7 Mon Sep 17 00:00:00 2001
From: Guodong Hu <quic_guodhu@quicinc.com>
Date: Mon, 8 Aug 2022 15:47:53 +0800
Subject: [PATCH] tinyalsa: support tinyalsa build for Linux

Upstream-Status: Pending

Signed-off-by: Guodong Hu <quic_guodhu@quicinc.com>
---
 Makefile.am    | 37 +++++++++++++++++++++++++++++++++++++
 configure.ac   | 32 ++++++++++++++++++++++++++++++++
 tinyalsa.pc.in | 10 ++++++++++
 3 files changed, 79 insertions(+)
 create mode 100644 Makefile.am
 create mode 100644 configure.ac
 create mode 100644 tinyalsa.pc.in

diff --git a/Makefile.am b/Makefile.am
new file mode 100644
index 0000000..e5018c7
--- /dev/null
+++ b/Makefile.am
@@ -0,0 +1,37 @@
+pkgconfigdir = $(libdir)/pkgconfig
+pkgconfig_DATA = tinyalsa.pc
+EXTRA_DIST = $(pkgconfig_DATA)
+
+AM_CFLAGS = -Wundef \
+            -Wstrict-prototypes \
+            -Wno-trigraphs \
+            -g -O0 \
+            -fno-inline \
+            -fno-short-enums \
+            -fpic
+
+DEFAULT_INCLUDES = -I${top_srcdir}/include
+
+c_sources = mixer.c \
+            pcm.c \
+            mixer_hw.c \
+            mixer_plugin.c \
+            pcm_hw.c \
+            pcm_plugin.c \
+            snd_utils.c
+
+h_sources = include/tinyalsa/asoundlib.h \
+            include/tinyalsa/mixer_plugin.h \
+            include/tinyalsa/pcm_plugin.h
+
+library_includedir = $(includedir)/tinyalsa
+library_include_HEADERS = $(h_sources)
+
+lib_LTLIBRARIES = libtinyalsa.la
+libtinyalsa_la_SOURCES = $(c_sources)
+libtinyalsa_la_LIBADD = $(GLIB_LIBS) -llog -lcutils
+libtinyalsa_la_CFLAGS := $(AM_CFLAGS)
+libtinyalsa_la_CFLAGS += $(GLIB_CFLAGS) -Dstrlcpy=g_strlcpy -Dstrlcat=g_strlcat
+libtinyalsa_la_CFLAGS += -D__unused=__attribute__\(\(__unused__\)\)
+libtinyalsa_la_CFLAGS += -DNDEBUG
+libtinyalsa_la_LDFLAGS = -shared -avoid-version
diff --git a/configure.ac b/configure.ac
new file mode 100644
index 0000000..d23250c
--- /dev/null
+++ b/configure.ac
@@ -0,0 +1,32 @@
+AC_PREREQ(2.69)
+AC_INIT([tinyalsa],1.0.0)
+AM_INIT_AUTOMAKE([foreign subdir-objects])
+
+AC_PROG_CC
+AM_PROG_CC_C_O
+AC_PROG_CXX
+AC_PROG_LIBTOOL
+AC_PROG_AWK
+AC_PROG_CPP
+AC_PROG_INSTALL
+AC_PROG_LN_S
+AC_PROG_MAKE_SET
+PKG_PROG_PKG_CONFIG
+
+AC_ARG_WITH([glib],
+      AC_HELP_STRING([--with-glib],
+         [enable glib, Build against glib. Use this when building for HLOS systems which use glib]))
+
+if (test "x${with_glib}" = "xyes"); then
+        PKG_CHECK_MODULES(GTHREAD, gthread-2.0 >= 2.16, dummy=yes,
+                                AC_MSG_ERROR(GThread >= 2.16 is required))
+        PKG_CHECK_MODULES(GLIB, glib-2.0 >= 2.16, dummy=yes,
+                                AC_MSG_ERROR(GLib >= 2.16 is required))
+        GLIB_CFLAGS="$GLIB_CFLAGS $GTHREAD_CFLAGS"
+        GLIB_LIBS="$GLIB_LIBS $GTHREAD_LIBS"
+
+        AC_SUBST(GLIB_CFLAGS)
+        AC_SUBST(GLIB_LIBS)
+fi
+AC_CONFIG_FILES([ Makefile tinyalsa.pc ])
+AC_OUTPUT
diff --git a/tinyalsa.pc.in b/tinyalsa.pc.in
new file mode 100644
index 0000000..3a36597
--- /dev/null
+++ b/tinyalsa.pc.in
@@ -0,0 +1,10 @@
+prefix=@prefix@
+exec_prefix=@exec_prefix@
+libdir=@libdir@
+includedir=@includedir@
+
+Name: tinyalsa
+Description: tinyalsa library
+Version: @VERSION@
+Libs: -L${libdir} -ltinyalsa
+Cflags: -I${includedir}/tinyalsa
-- 
2.7.4


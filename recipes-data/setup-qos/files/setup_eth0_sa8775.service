# This service file is designed to route TX traffic on eth0 interface.
# Customer needs to enable this service file based on the requirement.
# Flexibility is provided for the customers to modify QoS using TC.
[Unit]
Description=eth0 QOS installer
After=eth_module_load.service
Requires=eth_module_load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=ifconfig eth0 up
ExecStart=/etc/initscripts/setup_eth.sh /etc/initscripts/config.ini eth0
Nice=-20
Restart=on-failure
RestartSec=1ms

[Install]
WantedBy=multi-user.target

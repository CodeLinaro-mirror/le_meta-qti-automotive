# This service file is designed to route TX traffic on eth0 interface.
# Customer needs to enable this service file based on the requirement.
# Flexibility is provided for the customers to modify QoS using TC.
[Unit]
Description=eth0 QOS installer

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=tc qdisc add dev eth0 handle 100: parent root mqprio num_tc 4 map 0 2 1 2 3 2 2 2 2 2 2 2 2 2 2 2 queues 1@0 1@1 1@2 1@3 hw 0
ExecStart=tc qdisc add dev eth0 clsact
ExecStart=tc filter add dev eth0 egress prio 0 u32 match u16 0x88f7 0xffff at -2 action skbedit queue_mapping 1
ExecStart=tc filter add dev eth0 egress prio 0 u32 match u16 0x22f0 0xffff at -2 action skbedit queue_mapping 2
ExecStop=tc qdisc del dev eth0 root
Nice=-20
Restart=on-failure
RestartSec=1ms

[Install]
WantedBy=multi-user.target

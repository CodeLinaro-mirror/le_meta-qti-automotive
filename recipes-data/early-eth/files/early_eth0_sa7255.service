# This service file is designed for setting up eth0,
# provide new script to check interface up or not and then config eth0 in loop
[Unit]
Description=eth0 installer
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
After=eth_module_load.service
Requires=eth_module_load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/early_eth0_sa7255.sh
ExecStop=ifconfig eth0 down
Nice=-20
Restart=on-failure
RestartSec=1ms

[Install]
WantedBy=sysinit.target

# This service file is designed to route TX traffic on eth0 interface.
# Customer needs to enable this service file based on the requirement.
# Flexibility is provided for the customers to modify IP and mac addresses.
[Unit]
Description=eth0 installer
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
User=early-eth
Group=early-eth
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
Type=oneshot
RemainAfterExit=yes
#ExecStart=ifconfig eth0 hw ether 32:ff:2f:16:85:50
ExecStart=ifconfig eth0 up
ExecStop=ifconfig eth0 down
Nice=-20
Restart=on-failure
RestartSec=1ms

[Install]
WantedBy=sysinit.target

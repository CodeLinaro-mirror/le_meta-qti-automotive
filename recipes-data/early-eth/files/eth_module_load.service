[Unit]
Description=Load Ethernet kernel modules
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/eth_module_load.sh

[Install]
WantedBy=multi-user.target

+	    cnt++;
+
+	    if (sp->test->debug)
+		    printf("%d (%d) remaining %d\n", cnt, dgram_sz, buf_sz);
+
+	    /* Prevent buffer underflow */
+	    if (buf_sz < dgram_sz) {

# An OpenGLES app for kpi
#

[Unit]
Description=[Graphics] gles early client

Wants=openwfd_server_@0.service kgsl.service
After=openwfd_server_@0.service kgsl.service

Conflicts=shutdown.target
Before=shutdown.target
DefaultDependencies=no

[Service]
User=root
ExecStart=gles2-kpi -frames 1 -wm 0
Type=simple

[Install]
WantedBy=multi-user.target

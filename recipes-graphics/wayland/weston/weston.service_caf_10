[Unit]
Description=Weston reference Wayland compositor
Conflicts=getty@tty2.service shutdown.target
Requires=dev-dri-card0.device
After=dbus.service rc.pvr.service dev-dri-card0.device
DefaultDependencies=no
Before=shutdown.target

[Service]
User=root
PAMName=weston-autologin
Environment="XDG_RUNTIME_DIR=/run/user/0"
ExecStart=weston --idle-time=0 --socket=wayland-0 --modules=systemd-notify.so --log=/tmp/weston.log
Type=notify
PIDFile=/run/early/weston.pid
Restart=always
RestartSec=2
StartLimitInterval=100s
StartLimitBurst=5
TTYPath=/dev/tty2

[Install]
WantedBy=multi-user.target

From 7532d9ef703c5532cc35cd7c01c6879a84f3124d Mon Sep 17 00:00:00 2001
From: huiyang <quic_huiyang@quicinc.com>
Date: Tue, 18 Jul 2023 19:48:03 +0800
Subject: [PATCH] weston: add atrace marker for bebug

Add atrace marker for debug.
How to enable the trace:
1. add 'Environment="WESTON_TRACE=1"' to the file
weston.service
2. systemctl daemon-reload to update configuration
3. systemctl restart weston to enable the trace

Upstream-Status: Inappropriate [qti specific]

Change-Id: I09ba0b3bce18e7ed18979f6b0f5e640871cff3cc
Signed-off-by: huiyang <quic_huiyang@quicinc.com>
Signed-off-by: Min Cheng <quic_miche@quicinc.com>
(cherry picked from commit 2127f8d37916d54fc80eaa344153c8674f410d7b)
---
 include/libweston/libweston.h | 26 +++++++++++++++++++++++++-
 libweston/compositor.c        | 10 +++++++++-
 libweston/log.c               | 33 ++++++++++++++++++++++++++++++++-
 3 files changed, 66 insertions(+), 3 deletions(-)

diff --git a/include/libweston/libweston.h b/include/libweston/libweston.h
index 94d6dd0..3e8819c 100644
--- a/include/libweston/libweston.h
+++ b/include/libweston/libweston.h
@@ -26,7 +26,7 @@
  *
  * Changes from Qualcomm Technologies, Inc. are provided under the following license:
  *
- * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries. 
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  * SPDX-License-Identifier: BSD-3-Clause-Clear
  */
 
@@ -2411,6 +2411,30 @@ weston_log_paced(struct weston_log_pacer *pacer, unsigned int max_burst,
 void
 weston_place_marker(const char *name);
 
+bool
+weston_atrace_enable(void);
+
+void
+weston_atrace_marker(const char *type, const char *name);
+
+#define ATRACE_BEGIN(fmt_str, ...) \
+	do { \
+		if (weston_atrace_enable()) { \
+			char buf_begin[256]; \
+			snprintf(buf_begin, 256, fmt_str, ##__VA_ARGS__); \
+			weston_atrace_marker("B", buf_begin); \
+		} \
+	} while (0)
+
+#define ATRACE_END(fmt_str, ...) \
+	do { \
+		if (weston_atrace_enable()) { \
+			char buf_end[256]; \
+			snprintf(buf_end, 256, fmt_str, ##__VA_ARGS__); \
+			weston_atrace_marker("E", buf_end); \
+		} \
+	} while (0)
+
 enum weston_screenshooter_outcome {
 	WESTON_SCREENSHOOTER_SUCCESS,
 	WESTON_SCREENSHOOTER_NO_MEMORY,

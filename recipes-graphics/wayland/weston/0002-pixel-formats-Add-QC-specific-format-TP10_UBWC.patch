From eefa26cd03e5b64701fbbb353848b67b60a0661a Mon Sep 17 00:00:00 2001
From: Xiaoyu Huang <quic_xiahua@quicinc.com>
Date: Tue, 10 Dec 2024 10:29:39 +0000
Subject: [PATCH] pixel-formats: Add QC specific format TP10_UBWC

Upstream-Status: Inappropriate [qti specific]

Change-Id: I8ec14710266bdfa2ecb93c19aceb92454563bddb
Signed-off-by: Xiaoyu Huang <quic_xiahua@quicinc.com>
(cherry picked from commit 5af1fb998156c91cccaee48adc945f26f3857ed7)
---
 libweston/pixel-formats.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/libweston/pixel-formats.c b/libweston/pixel-formats.c
index 8d8360a..b4c9295 100644
--- a/libweston/pixel-formats.c
+++ b/libweston/pixel-formats.c
@@ -43,6 +43,7 @@
 #include "shared/xalloc.h"
 #include "wayland-util.h"
 #include "pixel-formats.h"
+#include "gbm_priv.h"
 
 #ifdef ENABLE_EGL
 #include <EGL/egl.h>
@@ -607,6 +608,10 @@ static const struct pixel_format_info pixel_format_table[] = {
 		DRM_FORMAT(XYUV8888),
 		.bpp = 32,
 	},
+	{
+		.format = GBM_FORMAT_YCbCr_420_TP10_UBWC,
+		.drm_format_name = "TP10_UBWC",
+	},
 };
 
 WL_EXPORT const struct pixel_format_info *

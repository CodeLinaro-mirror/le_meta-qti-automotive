From 66ebd009732a4c8816c8a6927901af4e724a8c52 Mon Sep 17 00:00:00 2001
From: Xiaoyu Huang <xiahua@qti.qualcomm.com>
Date: Mon, 19 Oct 2026 19:47:26 +0800
Subject: [PATCH] gl-renderer: clear capture FBO and redraw full output

The screen-capture path renders into a client-provided buffer that has
no buffer-age guarantee, so the repaint path's partial-update exemption
does not apply to it. Without clearing, any pixel not covered by a view
is left as the client last wrote it, so stale frames from the client's
ring buffer show through (e.g. a moved or destroyed surface keeps
appearing in the rectangle it vacated).

Clear the FBO to transparent black before drawing, and draw each paint
node against the full output region instead of incremental damage so
the freshly cleared buffer always receives a complete frame.

Upstream-Status: Inappropriate [qti specific]

Change-Id: Ib189e987fb8748c6c49248f5290ed5db2cba5934
Signed-off-by: Xiaoyu Huang <xiahua@qti.qualcomm.com>
---
 libweston/renderer-gl/gl-renderer.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/libweston/renderer-gl/gl-renderer.c b/libweston/renderer-gl/gl-renderer.c
index c5ca46c4..9e638ca9 100644
--- a/libweston/renderer-gl/gl-renderer.c
+++ b/libweston/renderer-gl/gl-renderer.c
@@ -2344,6 +2344,13 @@ gl_renderer_capture_screen(struct weston_output *output,
 			   gbm_buf->width,
 			   gbm_buf->height);
 
+	/* Capture dst is a client buffer with no buffer-age guarantee, so
+	 * the repaint path's partial-update exemption does not apply. Clear
+	 * it first; otherwise any pixel no view covers is left as the client
+	 * last wrote it (stale frames from the client's ring buffer). */
+	glClearColor(0.0, 0.0, 0.0, 0.0);
+	glClear(GL_COLOR_BUFFER_BIT);
+
 	/* Calculate the global GL matrix */
 	go->output_matrix = output->matrix;
 	weston_matrix_translate(&go->output_matrix,
@@ -2362,7 +2369,9 @@ gl_renderer_capture_screen(struct weston_output *output,
 				 z_order_link) {
 		if (screen_capture_backend->is_screen_capture_view(pnode->view))
 			continue;
-		draw_paint_node(pnode, &rb->base.damage);
+		/* Redraw the full output region, not incremental damage,
+		 * so the cleared capture buffer gets a complete frame. */
+		draw_paint_node(pnode, &output->region);
 	}
 
 	draw_output_borders(output, rb->border_damage);
-- 

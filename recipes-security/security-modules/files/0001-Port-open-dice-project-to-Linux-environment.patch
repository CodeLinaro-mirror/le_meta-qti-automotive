From 83a21f094d9b26edb7a6608005bc8020e93dbc69 Mon Sep 17 00:00:00 2001
From: Amit Blay <ablay@qti.qualcomm.com>
Date: Thu, 11 Dec 2025 10:49:34 -0800
Subject: Port open-dice project to Linux environment

1. Originally the open-dice supports BoringSSL for its crypto.
This patch port it to use OpenSSL, for systems with OpenSSL only support.

2. Add a Makefile to build exactly what's needed for Linux.

Change-Id: Ib41cee5bff49d454e0a9a4aacbf8f00acbb2fe6f
Signed-off-by: Amit Blay <ablay@qti.qualcomm.com>
---
 Makefile                   |  19 +++++
 src/openssl_ed25519_ops.c  | 142 +++++++++++++++++++++++++++++++++++++
 src/openssl_hash_kdf_ops.c |  77 ++++++++++++++++++++
 3 files changed, 238 insertions(+)
 create mode 100644 Makefile
 create mode 100644 src/openssl_ed25519_ops.c
 create mode 100644 src/openssl_hash_kdf_ops.c

diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..0e160be
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,19 @@
+CFLAGS += -Wall -g -O2 -fPIC
+#LDFLAGS += -shared
+TARGET = libopendice.so.1.0.0
+LIBS = -lssl -lcrypto
+SOURCES = src/android.c src/dice.c src/cbor_cert_op.c src/cbor_reader.c src/cbor_writer.c src/clear_memory.c src/openssl_ed25519_ops.c src/openssl_hash_kdf_ops.c src/utils.c
+INC = -I./include -I./include/dice/config/android -I./include/dice/config/boringssl_ed25519
+OBJECTS = $(SOURCES:.c=.o)
+
+all: $(TARGET)
+
+$(TARGET): $(OBJECTS)
+	$(CC) $(CFLAGS) $(INC) -shared -Wl,-soname,libopendice.so.1 \
+		$(LDFLAGS) $(LIBS) -o $@ $^
+
+%.o: %.c
+	$(CC) $(CFLAGS) $(INC) -c $< -o $@
+
+clean:
+	rm -f $(TARGET) $(OBJECTS)
diff --git a/src/openssl_ed25519_ops.c b/src/openssl_ed25519_ops.c
new file mode 100644
index 0000000..a41141e
--- /dev/null
+++ b/src/openssl_ed25519_ops.c
@@ -0,0 +1,142 @@
+// Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+
+// Copyright 2022 Google LLC
+//

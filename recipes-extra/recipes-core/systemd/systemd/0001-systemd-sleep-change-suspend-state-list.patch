From 736a38d02167fd345badfa6a414235908eab8ecf Mon Sep 17 00:00:00 2001
From: Feng Chen <quic_fch@quicinc.com>
Date: Thu, 22 Sep 2022 17:40:36 +0530
Subject: [PATCH] systemd-sleep: change suspend state list

Gvm does not support s2idle, remove it in systemd.
Change standby and freeze to mem sleep mode.

Upstream-Status: Pending

Signed-off-by: Feng Chen <quic_fch@quicinc.com>
---
 src/sleep/sleep.conf | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/sleep/sleep.conf b/src/sleep/sleep.conf
index dc2ed37f70..eb967c5fb9 100644
--- a/src/sleep/sleep.conf
+++ b/src/sleep/sleep.conf
@@ -17,7 +17,7 @@
 #AllowSuspendThenHibernate=yes
 #AllowHybridSleep=yes
 #SuspendMode=
-#SuspendState=mem standby freeze
+SuspendState=mem mem mem
 #HibernateMode=platform shutdown
 #HibernateState=disk
 #HybridSleepMode=suspend platform shutdown
-- 
2.17.1


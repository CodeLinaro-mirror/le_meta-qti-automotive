From 4a22f4c70eaa832609f4e1e239bfb5fa44f6b4a6 Mon Sep 17 00:00:00 2001
From: pengy <pengy@qti.qualcomm.com>
Date: Thu, 25 Sep 2025 10:13:08 +0800
Subject: [PATCH] udev:make symlink related rules be triggered earlier

qcrosvm.service depends on 60-persistent-storage.rules.
To optimize bootkpi, make this rule be loaded earlier.

Upstream-Status: Inappropriate

Signed-off-by: ziqic <ziqic@qti.qualcomm.com>
---
 units/systemd-udev-trigger.service | 1 +
 1 file changed, 1 insertion(+)

diff --git a/units/systemd-udev-trigger.service b/units/systemd-udev-trigger.service
index cb1e4f9fea..18e1bc5c4b 100644
--- a/units/systemd-udev-trigger.service
+++ b/units/systemd-udev-trigger.service
@@ -19,4 +19,5 @@ ConditionPathIsReadWrite=/sys
 [Service]
 Type=oneshot
 RemainAfterExit=yes
+ExecStart=-udevadm trigger -w --subsystem-match=block --type=devices --action=add
 ExecStart=-udevadm trigger --type=all --action=add --prioritized-subsystem=module,block,tpmrm,net,tty,input
-- 
2.34.1


[Unit]
Description=Service to set up the network bridge for the Android GVM
PartOf=qcrosvm_lv.service
After=setup-network-host.service

[Service]
Type=oneshot

ExecStart=/usr/bin/gvm-net-config-lvgvm.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy = multi-gvm.target
WantedBy = single-lv-gvm.target

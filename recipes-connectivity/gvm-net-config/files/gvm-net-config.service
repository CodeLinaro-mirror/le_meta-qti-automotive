[Unit]
Description=Service to set up the network bridge for the Android GVM
PartOf=qcrosvm.service

[Service]
Type=oneshot

ExecStart=/usr/bin/gvm-net-config.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy = single-gvm.target
WantedBy = multi-gvm.target

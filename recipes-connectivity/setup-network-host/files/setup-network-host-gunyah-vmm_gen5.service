# This service file is used to setup network ip on host

[Unit]
Description=Setup Host Network 
After=network-pre.target systemd-networkd.service systemd-networkd-wait-online.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=no
NoNewPrivileges=true
ExecStart=/usr/bin/setup-network-host-vmm.sh

[Install]
WantedBy=single-gvm.target
WantedBy=multi-gvm.target


[Unit]
Description=Bluetooth HCI Setup
After=bluetooth.mount sysinit.target systemd-modules-load

[Service]
Type=simple
RemainAfterExit=yes

# Environment configurable here
Environment=ENABLE_LOG=0
Environment=LOG_PATH=/var/log

ExecStart=/usr/bin/load_bt_modules.sh start
ExecStop=/usr/bin/load_bt_modules.sh stop

[Install]
WantedBy=single-lv-gvm.target

From ba92519f1c98134e4e9ba3f3e32025c75295509c Mon Sep 17 00:00:00 2001
From: Lei wang <quic_leiwan@quicinc.com>
Date: Tue, 30 Jul 2024 12:40:25 +0800
Subject: [PATCH] libsparse: Add makefile support for aosp libsparse

Upstream-Status:Inappropriate [Port for Linux Makefile support]

Signed-off-by: Lei wang <quic_leiwan@quicinc.com>
---
 Makefile.am     | 69 +++++++++++++++++++++++++++++++++++++++++++++++++
 configure.ac    | 53 +++++++++++++++++++++++++++++++++++++
 libsparse.pc.in | 10 +++++++
 3 files changed, 132 insertions(+)
 create mode 100644 libsparse/Makefile.am
 create mode 100644 libsparse/configure.ac
 create mode 100644 libsparse/libsparse.pc.in

diff --git a/Makefile.am b/Makefile.am
new file mode 100644
index 0000000000..992bb7b309
--- /dev/null
+++ b/Makefile.am
@@ -0,0 +1,69 @@
+AM_CFLAGS = -Wundef \
+        -Wstrict-prototypes \
+        -Wno-trigraphs \
+        -g -O0 \
+        -fno-inline \
+        -fno-short-enums \
+        -fpic \
+        -I${top_srcdir}/include
+
+AM_CPPFLAGS = $(AM_CFLAGS)
+
+ACLOCAL_AMFLAGS = -I m4
+
+### Build libsparse library
+
+libsparse_h_sources = include/sparse/sparse.h \
+        sparse_crc32.h
+
+libsparse_cpp_sources := backed_block.cpp \
+        output_file.cpp \
+        sparse.cpp \
+        sparse_crc32.cpp \
+        sparse_err.cpp \
+        sparse_read.cpp
+
+libsparse_la_SOURCES = $(libsparse_cpp_sources) $(libsparse_h_sources)
+libsparse_la_LDFLAGS = $(Z_LIB)
+
+### Export library
+lib_LTLIBRARIES = libsparse.la
+
+pkgconfigdir = $(libdir)/pkgconfig
+pkgconfig_DATA = libsparse.pc
+EXTRA_DIST = $(pkgconfig_DATA)
+
+### Export headers
+library_includedir = $(includedir)/sparse
+library_include_HEADERS = $(libsparse_h_sources)
+
+
+if IMG_CONVERT_UTILS
+bin_PROGRAMS:=simg2img \
+             img2simg \
+             append2simg
+
+simg2img_cpp_sources := simg2img.cpp \
+        sparse_crc32.cpp
+simg2img_SOURCES :=$(simg2img_cpp_sources)
+simg2img_CPPFLAGS := $(AM_CFLAGS) \
+                   -Wno-strict-prototypes
+simg2img_LDADD =libsparse.la
+simg2img_LDFLAGS = @Z_LIB@
+
+#bin_PROGRAMS=img2simg
+img2simg_cpp_sources := img2simg.cpp
+img2simg_SOURCES :=$(img2simg_cpp_sources)
+img2simg_CPPFLAGS := $(AM_CFLAGS) \
+                   -Wno-strict-prototypes
+img2simg_LDADD =libsparse.la
+img2simg_LDFLAGS = @Z_LIB@
+
+#bin_PROGRAMS=append2simg
+append2simg_cpp_sources := append2simg.cpp
+append2simg_SOURCES := $(append2simg_cpp_sources)
+append2simg_CPPFLAGS := $(AM_CFLAGS) \
+                      -Wno-strict-prototypes
+append2simg_LDADD =libsparse.la
+append2simg_LDFLAGS = @Z_LIB@
+endif
diff --git a/configure.ac b/configure.ac
new file mode 100644
index 0000000000..b43e6b9be5
--- /dev/null
+++ b/configure.ac
@@ -0,0 +1,53 @@
+  AC_PREREQ(2.61)
+
+  AC_INIT([libsparse],1.0.0)
+
+  AM_INIT_AUTOMAKE([foreign])
+
+  AM_MAINTAINER_MODE
+
+  AC_CONFIG_HEADER([config.h])
+  AC_CONFIG_MACRO_DIR([m4])
+
+  # Checks for programs.
+  AM_PROG_AS
+  AC_PROG_CC
+  AM_PROG_CC_C_O
+  AC_PROG_LIBTOOL
+  AC_PROG_AWK
+  AC_PROG_CPP
+  AC_PROG_CXX
+  AC_PROG_INSTALL
+  AC_PROG_LN_S
+  AC_PROG_MAKE_SET
+
+  AC_ARG_ENABLE(img-convert-utils,
+      AC_HELP_STRING([--disable-img-convert-utils], [Don't build utilities needed for sparse to unsparse image conversion.]),
+              [img_convert_utils=${enableval}], [img_convert_utils="no"])
+
+  AM_CONDITIONAL([IMG_CONVERT_UTILS],[test "x${img_convert_utils}" = "xyes"])
+
+  AC_MSG_CHECKING(for zlib support)
+  AC_ARG_WITH(zlib, AC_HELP_STRING([--with-zlib],[Enable zlib support for mod_compress]),
+      [WITH_ZLIB=$withval],[WITH_ZLIB=yes])
+  AC_MSG_RESULT([$WITH_ZLIB])
+
+  if test "$WITH_ZLIB" != "no"; then
+    AC_CHECK_LIB(z, deflate, [
+      AC_CHECK_HEADERS([zlib.h],[
+        Z_LIB=-lz
+        AC_DEFINE([HAVE_LIBZ], [1], [libz])
+        AC_DEFINE([HAVE_ZLIB_H], [1])
+      ])
+    ])
+    if test x$Z_LIB = x; then
+       AC_MSG_ERROR([zlib-headers and/or libs where not found, install them or build with --without-zlib])
+    fi
+  fi
+  AC_SUBST(Z_LIB)
+
+
+  AC_OUTPUT([ \
+          Makefile \
+          libsparse.pc
+  ])
diff --git a/libsparse.pc.in b/libsparse.pc.in
new file mode 100644
index 0000000000..f1864b72c3
--- /dev/null
+++ b/libsparse.pc.in
@@ -0,0 +1,10 @@
+prefix=@prefix@
+exec_prefix=@exec_prefix@
+libdir=@libdir@
+includedir=@includedir@
+
+Name: sparse library
+Description: sparse library used by make_extfs
+Version: @VERSION@
+Libs: -L${libdir} -lsparse
+Cflags: -I${includedir}/libsparse
-- 
2.25.1


+libsmapinfo_la_CPPFLAGS += $(AM_CPPFLAGS) -Wno-error=pointer-to-int-cast
+libsmapinfo_la_CPPFLAGS += -std=c++20
+libsmapinfo_la_CPPFLAGS += -I$(srcdir)/include
+
+#libdmabufinfo_la_CPPFLAGS += @LIBBASE_CFLAGS@
+#libdmabufinfo_la_LDFLAGS = @LIBBASE_LIBS@
+
+libsmapinfo_la_LIBADD = -lbase -lprocinfo

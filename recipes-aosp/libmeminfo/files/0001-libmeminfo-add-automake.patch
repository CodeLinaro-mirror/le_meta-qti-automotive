diff --git a/libsmapinfo/Makefile.am b/libsmapinfo/Makefile.am
new file mode 100644
index 0000000..8fd66f6
--- /dev/null
+++ b/libsmapinfo/Makefile.am
@@ -0,0 +1,26 @@
+AM_CPPFLAGS := \
+    -W \
+    -Wall \
+    -Wextra \
+    -Wunused \
+    -Wno-missing-field-initializers
+
+ACLOCAL_AMFLAGS = -I m4
+
+libsmapinfo_la_SOURCES = processrecord.cpp smapinfo.cpp
+lib_LTLIBRARIES = libsmapinfo.la
+

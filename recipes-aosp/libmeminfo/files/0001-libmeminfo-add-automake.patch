From b80b89d98ab7a4f798f24fdd82a09eb9f313bf88 Mon Sep 17 00:00:00 2001
From: Naiwen Yu <naiwyu@qti.qualcomm.com>
Date: Mon, 13 Oct 2025 10:17:08 +0800
Subject: [PATCH] libmeminfo: add automake

Create automake files for libmeminfo

Upstream-Status: Inappropriate
Signed-off-by: Naiwen Yu <naiwyu@qti.qualcomm.com>
---
 Makefile.am                       | 28 +++++++++++++
 configure.ac                      | 36 +++++++++++++++++
 libdmabufinfo/Makefile.am         | 29 +++++++++++++
 libdmabufinfo/libdmabufinfo.pc.in | 14 +++++++
 libdmabufinfo/tools/Makefile.am   | 21 ++++++++++
 libmeminfo.pc.in                  | 14 +++++++
 libsmapinfo/Makefile.am           | 26 ++++++++++++
 tools/Makefile.am                 | 67 +++++++++++++++++++++++++++++++
 8 files changed, 235 insertions(+)
 create mode 100644 Makefile.am
 create mode 100644 configure.ac
 create mode 100644 libdmabufinfo/Makefile.am
 create mode 100644 libdmabufinfo/libdmabufinfo.pc.in
 create mode 100644 libdmabufinfo/tools/Makefile.am
 create mode 100644 libmeminfo.pc.in
 create mode 100644 libsmapinfo/Makefile.am
 create mode 100644 tools/Makefile.am

diff --git a/Makefile.am b/Makefile.am
new file mode 100644
index 0000000..a7dadc2
--- /dev/null
+++ b/Makefile.am
@@ -0,0 +1,28 @@
+AM_CPPFLAGS := \
+    -W \
+    -Wall \
+    -Wextra \
+    -Wunused \
+    -Wno-missing-field-initializers
+
+ACLOCAL_AMFLAGS = -I m4
+
+
+SUBDIRS = libdmabufinfo . libsmapinfo tools
+
+# Build libmeminfo.so
+libmeminfo_sources = procmeminfo.cpp sysmeminfo.cpp pageacct.cpp
+lib_LTLIBRARIES = libmeminfo.la
+libmeminfo_la_SOURCES = $(libmeminfo_sources)
+libmeminfo_la_CPPFLAGS = -I$(top_srcdir)/include -I$(top_srcdir)/include/meminfo
+libmeminfo_la_CPPFLAGS += -I$(top_srcdir)/libdmabufinfo/include
+libmeminfo_la_CPPFLAGS += $(AM_CPPFLAGS) -Wno-error=pointer-to-int-cast
+libmeminfo_la_CPPFLAGS += -std=c++20
+libmeminfo_la_CPPFLAGS += @LIBBASE_CFLAGS@ 
+libmeminfo_la_LDFLAGS = @LIBBASE_LIBS@ -L./libdmabufinfo/ -ldmabufinfo 
+# Export headers
+libmeminfo_includedir=$(includedir)/meminfo
+
+pkgconfigdir := $(libdir)/pkgconfig
+pkgconfig_DATA := libmeminfo.pc
+EXTRA_DIST := $(pkgconfig_DATA)
diff --git a/configure.ac b/configure.ac
new file mode 100644
index 0000000..c5ab7d5
--- /dev/null
+++ b/configure.ac
@@ -0,0 +1,36 @@
+AC_PREREQ(2.61)
+AC_INIT([libmeminfo],1.0.0)
+AM_INIT_AUTOMAKE([-Wall gnu foreign])
+AC_CONFIG_SRCDIR([Makefile.am])
+AC_CONFIG_HEADERS([config.h])
+AC_CONFIG_MACRO_DIR([m4])
+
+# Check for programs
+AM_PROG_AS
+AC_PROG_CC
+AM_PROG_CC_C_O
+AC_PROG_LIBTOOL
+AC_PROG_AWK
+AC_PROG_CPP
+AC_PROG_CXX
+AC_PROG_INSTALL
+AC_PROG_LN_S
+AC_PROG_MAKE_SET
+PKG_PROG_PKG_CONFIG
+
+PKG_CHECK_MODULES([LIBBASE], [libbase])
+AC_SUBST([LIBBASE_CFLAGS])
+AC_SUBST([LIBBASE_LIBS])
+
+AC_CONFIG_FILES([ \
+    libdmabufinfo/Makefile \
+    libdmabufinfo/tools/Makefile \
+    libdmabufinfo/libdmabufinfo.pc \
+    Makefile \
+    libmeminfo.pc \
+    tools/Makefile \
+    libsmapinfo/Makefile \
+])
+
+AC_OUTPUT
+
diff --git a/libdmabufinfo/Makefile.am b/libdmabufinfo/Makefile.am
new file mode 100644
index 0000000..77ad6dc
--- /dev/null
+++ b/libdmabufinfo/Makefile.am
@@ -0,0 +1,29 @@
+AM_CPPFLAGS := \
+    -W \
+    -Wall \
+    -Wextra \
+    -Wunused \
+    -Wno-missing-field-initializers
+
+ACLOCAL_AMFLAGS = -I m4
+
+SUBDIRS = .  tools
+
+
+# Build libdmabufinfo.so
+libdmabufinfo_sources = dmabufinfo.cpp dmabuf_sysfs_stats.cpp
+lib_LTLIBRARIES = libdmabufinfo.la
+
+libdmabufinfo_la_SOURCES = $(libdmabufinfo_sources)
+libdmabufinfo_la_CPPFLAGS = -I$(top_srcdir)/include
+libdmabufinfo_la_CPPFLAGS += $(AM_CPPFLAGS) -Wno-error=pointer-to-int-cast
+libdmabufinfo_la_CPPFLAGS += -std=c++20
+libdmabufinfo_la_CPPFLAGS += -I$(srcdir)/include
+
+libdmabufinfo_la_CPPFLAGS += @LIBBASE_CFLAGS@
+libdmabufinfo_la_LDFLAGS = @LIBBASE_LIBS@
+
+# Export headers
+dmabufinfo_includedir=$(includedir)/dmabufinfo
+dmabufinfo_include_HEADERS := include/dmabufinfo/dmabufinfo.h
+dmabufinfo_include_HEADERS += include/dmabufinfo/dmabuf_sysfs_stats.h
diff --git a/libdmabufinfo/libdmabufinfo.pc.in b/libdmabufinfo/libdmabufinfo.pc.in
new file mode 100644
index 0000000..8f66e46
--- /dev/null
+++ b/libdmabufinfo/libdmabufinfo.pc.in
@@ -0,0 +1,14 @@
+prefix=@prefix@
+exec_prefix=@exec_prefix@
+libdir=@libdir@
+includedir=@includedir@
+
+Name: libdmabufinfo
+Description: libdmabufinfo library
+Version: @VERSION@
+Libs: -L${libdir} -ldmabufinfo
+Cflags: -I${includedir}
+
+Name: dmabuf_dump
+Description: dmabuf_dump tool
+Version: @VERSION@
diff --git a/libdmabufinfo/tools/Makefile.am b/libdmabufinfo/tools/Makefile.am
new file mode 100644
index 0000000..8c6190a
--- /dev/null
+++ b/libdmabufinfo/tools/Makefile.am
@@ -0,0 +1,21 @@
+AM_CPPFLAGS := \
+    -W \
+    -Wall \
+    -Wextra \
+    -Wunused \
+    -Wno-missing-field-initializers
+
+ACLOCAL_AMFLAGS = -I m4
+
+# Build tool dmabuf_dump
+bin_PROGRAMS = dmabuf_dump
+
+dmabuf_dump_SOURCES = dmabuf_dump.cpp
+dmabuf_dump_CPPFLAGS = $(AM_CPPFLAGS) -Wno-error=pointer-to-int-cast
+dmabuf_dump_CPPFLAGS += -I$(top_srcdir)/include
+dmabuf_dump_CPPFLAGS += -std=c++20
+dmabuf_dump_CPPFLAGS += @LIBBASE_CFLAGS@ 
+dmabuf_dump_CPPFLAGS += -I$(srcdir)/../include
+dmabuf_dump_LDFLAGS = @LIBBASE_LIBS@
+dmabuf_dump_LDADD   = ../libdmabufinfo.la
+

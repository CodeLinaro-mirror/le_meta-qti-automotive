From ffbed6214289b2ecddfebd7afd83b5c7bdded112 Mon Sep 17 00:00:00 2001
From: Naiwen Yu <naiwyu@qti.qualcomm.com>
Date: Mon, 13 Oct 2025 11:10:36 +0800
Subject: [PATCH] libprocinfo: solve build issues under yocto

Solve build issues under yocto environment

Upstream-Status: Inappropriate
Signed-off-by: Naiwen Yu <naiwyu@qti.qualcomm.com>
---
 include/procinfo/process.h     | 8 ++++----
 include/procinfo/process_map.h | 4 ++--
 process.cpp                    | 6 +++---
 3 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/include/procinfo/process.h b/include/procinfo/process.h
index 7d6a1d5..d9939ca 100644
--- a/include/procinfo/process.h
+++ b/include/procinfo/process.h
@@ -27,10 +27,10 @@
 #include <string>
 #include <type_traits>
 
-#include <android-base/file.h>
-#include <android-base/parseint.h>
-#include <android-base/stringprintf.h>
-#include <android-base/unique_fd.h>
+#include <base/file.h>
+#include <base/parseint.h>
+#include <base/stringprintf.h>
+#include <base/unique_fd.h>
 
 namespace android {
 namespace procinfo {
diff --git a/include/procinfo/process_map.h b/include/procinfo/process_map.h
index 5e5374e..f98d4ad 100644
--- a/include/procinfo/process_map.h
+++ b/include/procinfo/process_map.h
@@ -31,8 +31,8 @@
 #include <string>
 #include <vector>
 
-#include <android-base/file.h>
-#include <android-base/strings.h>
+#include <base/file.h>
+#include <base/strings.h>
 
 namespace android {
 namespace procinfo {
diff --git a/process.cpp b/process.cpp
index ef0e715..94423bd 100644
--- a/process.cpp
+++ b/process.cpp
@@ -28,9 +28,9 @@
 #include <string>
 #include <utility>
 
-#include <android-base/file.h>
-#include <android-base/stringprintf.h>
-#include <android-base/unique_fd.h>
+#include <base/file.h>
+#include <base/stringprintf.h>
+#include <base/unique_fd.h>
 
 using android::base::unique_fd;
 
-- 
2.34.1


Subject: [PATCH] libdp: update fs_mgr to work in LV

update device path for partiton opener

Signed-off-by: Lei wang <quic_leiwan@quicinc.com>
---
 fs_mgr/liblp/partition_opener.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/fs_mgr/liblp/partition_opener.cpp b/fs_mgr/liblp/partition_opener.cpp
index 1d4db85..b401521 100644
--- a/fs_mgr/liblp/partition_opener.cpp
+++ b/fs_mgr/liblp/partition_opener.cpp
@@ -42,7 +42,11 @@ std::string GetPartitionAbsolutePath(const std::string& path) {
         return path;
     }
 
+#if defined(__linux__) && !defined(__ANDROID__)
+    auto by_name = "/dev/disk/by-partlabel/" + path;
+#else
     auto by_name = "/dev/block/by-name/" + path;
+#endif
     if (access(by_name.c_str(), F_OK) != 0) {

[Unit]
Description=Run custom script at startup
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/cpu_offline.sh 0 11 14-17 12-13 12-13
Restart=on-failure

[Install]
WantedBy=multi-user.target

#!/usr/bin/make -f
#
# Source layout (relative to this package directory):
#   src/          → symlink to external/wpa_supplicant_8 (whole repo)
#   src/wpa_supplicant/ → actual build dir (external/wpa_supplicant_8/wpa_supplicant)
#   files/        → config files (defconfig-qcacld, wpa_supplicant.conf-sane, etc.)
#   debian/       → this file
#
# CURDIR == layers/meta-qti-automotive/recipes-wlan/wpa-supplicant/
# WPA_SRC == CURDIR/src/wpa_supplicant
#
# Parallel build: uses all available CPUs

export DH_VERBOSE = 1

FILES_DIR := $(CURDIR)/files
PKG_DIR   := $(CURDIR)/debian/wpasupplicant

# WPA source: src/ → ../../../../external/wpa_supplicant_8 (whole repo)
# WPA_SRC = src/wpa_supplicant matches external/wpa_supplicant_8/wpa_supplicant
WPA_SRC   := $(CURDIR)/src/wpa_supplicant

# Install prefix
BINDIR    := /usr/sbin
LIBDIR    := /usr/lib
INCDIR    := /usr/include

# Parallel jobs: honour DEB_BUILD_OPTIONS=parallel=N, default to nproc
NJOBS     := $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
ifeq ($(NJOBS),)
NJOBS     := $(shell nproc)
endif

%:
	dh $@

# ---------------------------------------------------------------------------
# do_configure:
# ---------------------------------------------------------------------------
override_dh_auto_configure:
	install -m 0644 $(FILES_DIR)/defconfig-qcacld $(WPA_SRC)/.config
	echo 'CFLAGS +="-I/usr/include/libnl3"' >> $(WPA_SRC)/.config

# ---------------------------------------------------------------------------
# do_compile equivalent (autotools-brokensep: build in source dir)
# Multi-threaded: -j$(NJOBS) passed explicitly
# ---------------------------------------------------------------------------
override_dh_auto_build:
	$(MAKE) -C $(WPA_SRC) -j$(NJOBS) \
		CC=$(CC) \
		BINDIR=$(BINDIR) \
		LIBDIR=$(LIBDIR)

# ---------------------------------------------------------------------------
# do_install:
# ---------------------------------------------------------------------------
override_dh_auto_install:
	# Install main binary, libraries, headers
	$(MAKE) -C $(WPA_SRC) install \
		DESTDIR=$(PKG_DIR) \
		BINDIR=$(BINDIR) \
		LIBDIR=$(LIBDIR) \
		INCDIR=$(INCDIR)

	# Install runtime config → /etc/wpa_supplicant.conf
	install -d $(PKG_DIR)/etc
	install -m 0600 $(FILES_DIR)/wpa_supplicant.conf-sane \
		$(PKG_DIR)/etc/wpa_supplicant.conf

	# Install ifupdown hooks (equivalent to bb network/if-pre-up.d install)
	install -d $(PKG_DIR)/etc/network/if-pre-up.d
	install -d $(PKG_DIR)/etc/network/if-post-down.d
	install -m 0755 $(FILES_DIR)/wpa-supplicant.sh \
		$(PKG_DIR)/etc/network/if-pre-up.d/wpa-supplicant
	cd $(PKG_DIR)/etc/network && \
		ln -sf ../if-pre-up.d/wpa-supplicant if-post-down.d/wpa-supplicant

	# Install DBus system config
	install -d $(PKG_DIR)/etc/dbus-1/system.d
	install -m 0644 $(WPA_SRC)/dbus/dbus-wpa_supplicant.conf \
		$(PKG_DIR)/etc/dbus-1/system.d/

	# Install DBus service activation file (generated by make install from .in template)
	install -d $(PKG_DIR)/usr/share/dbus-1/system-services
	if ls $(WPA_SRC)/dbus/*.service 2>/dev/null; then \
		install -m 0644 $(WPA_SRC)/dbus/*.service \
			$(PKG_DIR)/usr/share/dbus-1/system-services/; \
	fi

	# Install systemd service files (generated by make install from .in templates)
	install -d $(PKG_DIR)/lib/systemd/system
	if ls $(WPA_SRC)/systemd/*.service 2>/dev/null; then \
		install -m 0644 $(WPA_SRC)/systemd/*.service \
			$(PKG_DIR)/lib/systemd/system/; \
	fi

	# Install volatile directory config → /etc/default/volatiles/99_wpa_supplicant
	install -d $(PKG_DIR)/etc/default/volatiles
	install -m 0644 $(FILES_DIR)/99_wpa_supplicant \
		$(PKG_DIR)/etc/default/volatiles/

	# Install AppArmor profile
	install -d $(PKG_DIR)/etc/apparmor.d
	install -m 0644 $(FILES_DIR)/usr.sbin.wpa_supplicant \
		$(PKG_DIR)/etc/apparmor.d/usr.sbin.wpa_supplicant

override_dh_installsystemd:
	# wpa_supplicant.service installed but NOT auto-enabled
	dh_installsystemd --name=wpa_supplicant --no-enable --no-start

override_dh_auto_clean:
	$(MAKE) -C $(WPA_SRC) clean || true
	rm -f $(WPA_SRC)/.config


[Unit]
Description=MODPROBE_WLAN_MODULE
After=firmware-links.service firmware.mount usr-lib-firmware-qcom.mount sysinit.target systemd-modules-load.service
Conflicts=shutdown.target

[Service]
Type=simple
#Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/init.qti.wlan_on.sh
ExecStop=/usr/bin/init.qti.wlan_off.sh
AmbientCapabilities=CAP_SYS_MODULE CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
NoNewPrivileges=true
[Install]
WantedBy=default.target

From f84815f343e728f8ad43dd2c1703ea0aaf6b6462 Mon Sep 17 00:00:00 2001
From: Yimin Peng <yiminp@qti.qualcomm.com>
Date: Thu, 16 Jul 2026 14:23:43 +0800
Subject: [PATCH] soc-repo:add Kbuild for gvm-gen4-5

Change-Id: I7cfc02996a89d81bcfd039601ba90f58c5b45d19
Signed-off-by: Yimin Peng <yiminp@qti.qualcomm.com>
---
 Kbuild                 | 24 ++++++++++++++++++++++++
 drivers/iommu/Makefile |  2 +-
 2 files changed, 25 insertions(+), 1 deletion(-)
 create mode 100644 Kbuild

diff --git a/Kbuild b/Kbuild
new file mode 100644
index 000000000000..b78491a429f9
--- /dev/null
+++ b/Kbuild
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# soc-repo/Kbuild
+#
+# OOT entry point for building soc-repo modules against a pre-built ACK kernel.
+# Invoked as:
+#   make -C kernel-source O=KBA M=soc-repo/ modules
+#
+# The kernel build system (scripts/Kbuild.include) selects the entry point via:
+#   kbuild-file = $(or $(wildcard $(src)/Kbuild), $(src)/Makefile)
+#
+# This Kbuild file must exist to prevent the build system from falling back to
+# soc-repo/Makefile (a full kernel Makefile v6.11) which would cause version
+# mismatches with kernel-source (v6.12) and trigger unwanted outputmakefile,
+# archprepare, and other full-kernel build targets.
+
+obj-y += arch/arm64/gunyah/
+obj-y += drivers/
+obj-y += kernel/
+obj-y += lib/
+obj-y += mm/
+obj-y += net/qmsgq/
+obj-y += net/qrtr/
+obj-y += sound/
diff --git a/drivers/iommu/Makefile b/drivers/iommu/Makefile
index 9d50fd4cb3f5..c57c48a35197 100644
--- a/drivers/iommu/Makefile
+++ b/drivers/iommu/Makefile
@@ -11,7 +11,7 @@ obj-$(CONFIG_QTI_IOMMU_SUPPORT) += iommu-logger.o
 obj-$(CONFIG_QCOM_LAZY_MAPPING) += msm_dma_iommu_mapping.o
 
 obj-$(CONFIG_QCOM_IOMMU_DEBUG) += qcom_iommu_debug.o
-qcom_iommu_debug-objs += qcom-iommu-debug-user.o qcom-iommu-debug.o
+qcom_iommu_debug-objs += qcom-iommu-debug-user.o qcom-iommu-debug.o qcom-iommu-debug-alloc.o
 
 obj-$(CONFIG_QCOM_IOMMU_UTIL) += qcom_iommu_util.o
 qcom_iommu_util-objs += qcom-iommu-util.o
-- 
2.34.1


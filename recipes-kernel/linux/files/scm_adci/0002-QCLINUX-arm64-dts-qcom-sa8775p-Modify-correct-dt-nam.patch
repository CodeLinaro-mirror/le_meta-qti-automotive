Subject: [PATCH 2/9] QCLINUX: arm64: dts: qcom: sa8775p: Modify correct dt
 name for SCM

This change is required as this node is looked up and
patched by hypervisor.

Change-Id: I4445efc7306ab67d9fffa23c565ebbc800f1f88c
Signed-off-by: Ninad Naik <quic_ninanaik@quicinc.com>
---
 arch/arm64/boot/dts/qcom/sa8775p.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sa8775p.dtsi b/arch/arm64/boot/dts/qcom/sa8775p.dtsi
index 9dc39a0eee89..37b61935de13 100644
--- a/arch/arm64/boot/dts/qcom/sa8775p.dtsi
+++ b/arch/arm64/boot/dts/qcom/sa8775p.dtsi
@@ -473,7 +473,7 @@ eud_in: endpoint {
 	};
 
 	firmware {
-		scm {
+		qcom_scm {
 			compatible = "qcom,scm-sa8775p", "qcom,scm";
 			qcom,dload-mode = <&tcsr 0x13000>;
 			memory-region = <&tz_ffi_mem>;

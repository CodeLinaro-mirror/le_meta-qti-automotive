CONFIG_EXTRA_FIRMWARE=""
CONFIG_FTRACE=y
CONFIG_LOCALVERSION="-debug"
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_WQ_WATCHDOG=y
CONFIG_BLK_DEBUG_FS=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_PREEMPT=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DYNAMIC_DEBUG_CORE=y
CONFIG_FUNCTION_ERROR_INJECTION=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_SCHED_DEBUG=y

# Additional debug-only options migrated out of kernel_defconfig
# (previously duplicated from a PVM/LY011 debug .config; see LV053-060
# meta-qti-automotive commit history). Values below come from the gen5
# platform's own kernel_platform/kernel/arch/arm64/configs/qcom_gen5auto_debug.config
# where matching, and from the original kernel_defconfig baseline otherwise.
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_CMA_DEBUGFS=y
CONFIG_DEBUG_IRQFLAGS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_RWSEMS=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DMABUF_SYSFS_STATS=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_ARGS=y
CONFIG_DYNAMIC_FTRACE_WITH_CALL_OPS=y
CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y
CONFIG_FTRACE_MCOUNT_RECORD=y
CONFIG_FTRACE_MCOUNT_USE_PATCHABLE_FUNCTION_ENTRY=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_FUNCTION_ALIGNMENT=8
CONFIG_FUNCTION_ALIGNMENT_8B=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_FUNCTION_TRACER=y
CONFIG_GENERIC_TRACER=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HAVE_DYNAMIC_FTRACE_WITH_CALL_OPS=y
CONFIG_HAVE_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y
CONFIG_HWLAT_TRACER=y
CONFIG_LOCKUP_DETECTOR=y
CONFIG_PAGE_POISONING=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y
CONFIG_PCIEAER_INJECT=y
CONFIG_PID_IN_CONTEXTIDR=y
CONFIG_RCU_CPU_STALL_CPUTIME=y
CONFIG_SCHED_TRACER=y
CONFIG_STACK_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_TRACER_MAX_TRACE=y
CONFIG_TRACER_SNAPSHOT=y
CONFIG_WQ_CPU_INTENSIVE_REPORT=y
CONFIG_KASAN=y
CONFIG_KASAN_SW_TAGS=y
CONFIG_KASAN_OUTLINE=y
CONFIG_KASAN_STACK=y
CONFIG_KASAN_VMALLOC=y

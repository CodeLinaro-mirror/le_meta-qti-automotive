From d03951ed8df8b9b1eca54e8dba0b4b0440274356 Mon Sep 17 00:00:00 2001
From: Lei wang <quic_leiwan@quicinc.com>
Date: Wed, 30 Sep 2020 15:07:33 +0800
Subject: [PATCH] systemd: Make root's home directory configurabl

change default root home from /root/ to /home/root/.

Upstream-Status: Inappropriate

Signed-off-by: Lei wang <quic_leiwan@quicinc.com>
---
 src/basic/user-util.c | 4 ++--
 src/nspawn/nspawn.c   | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/basic/user-util.c b/src/basic/user-util.c
index 93ba4ee..6720995 100644
--- a/src/basic/user-util.c
+++ b/src/basic/user-util.c
@@ -122,7 +122,7 @@ static int synthesize_user_creds(
                         *gid = 0;
 
                 if (home)
-                        *home = "/root";
+                        *home = "/home/root";
 
                 if (shell)
                         *shell = "/bin/sh";
@@ -487,7 +487,7 @@ int get_home_dir(char **_h) {
         /* Hardcode home directory for root and nobody to avoid NSS */
         u = getuid();
         if (u == 0) {
-                h = strdup("/root");
+                h = strdup("/home/root");
                 if (!h)
                         return -ENOMEM;
 
diff --git a/src/nspawn/nspawn.c b/src/nspawn/nspawn.c
index 873a765..2967198 100644
--- a/src/nspawn/nspawn.c
+++ b/src/nspawn/nspawn.c
@@ -3102,7 +3102,7 @@ static int inner_child(
                 n_env++;
 
         if (home || !uid_is_valid(arg_uid) || arg_uid == 0)
-                if (asprintf((char**)(envp + n_env++), "HOME=%s", home ?: "/root") < 0)
+                if (asprintf((char**)(envp + n_env++), "HOME=%s", home ?: "/home/root") < 0)
                         return log_oom();
 
         if (arg_user || !uid_is_valid(arg_uid) || arg_uid == 0)
@@ -3196,7 +3196,7 @@ static int inner_child(
         } else {
                 if (!arg_chdir)
                         /* If we cannot change the directory, we'll end up in /, that is expected. */
-                        (void) chdir(home ?: "/root");
+                        (void) chdir(home ?: "/home/root");
 
                 execle("/bin/bash", "-bash", NULL, env_use);
                 execle("/bin/sh", "-sh", NULL, env_use);
-- 
2.7.4


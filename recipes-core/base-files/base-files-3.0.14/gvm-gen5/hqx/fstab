# stock fstab - you probably want to override this with a machine specific one

proc                 /proc           proc      defaults              0  0
devpts               /dev/pts        devpts    mode=0620,gid=5       0  0
usbdevfs             /proc/bus/usb   usbdevfs  noauto                0  0
tmpfs                /run            tmpfs     mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile   tmpfs     defaults 0  0
tmpfs                /media/ram      tmpfs     defaults,noauto       0  0

# Considering the fact that AppArmor checks both the access to
# the symbol link itself and to the target path, a /tmp which
# is not a symbol link to somewhere else is needed. And also,
# mounting /tmp as a tmpfs is some usual implementation.
tmpfs                /tmp            tmpfs     defaults              0  0

/dev/vdc             /var            auto      defaults,nofail       0  2
/dev/vdb             /data           auto      defaults,nofail       0  2
#/dev/vdg             /dsp            auto      defaults,ro,nofail    0  0
#/dev/vde             /firmware       auto      defaults,ro,nofail    0  0
#/dev/vdd             /bluetooth      auto      defaults,ro,nofail    0  0

# Bind /home to /data
/data                /home                auto       defaults,bind         0  0
/var                 /persist             auto       defaults,bind         0  0

# uncomment this if your device has a SD/MMC/Transflash slot
/dev/mmcblk0p1       /media/card          auto       defaults,sync,noauto  0  0

#Automatically mount binder drivers
binder               /dev/binderfs        binder     auto,exec,dev,nofail  0  0

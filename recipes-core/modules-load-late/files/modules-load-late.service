[Unit]
Description=Load kernel modules late
After=systemd-modules-load.service
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=modprobe tz_log

[Install]
WantedBy=multi-user.target

[Unit]
Description=Load kernel modules late
After=systemd-modules-load.service early-services.target
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
User=modules-load
Group=modules-load
CapabilityBoundingSet=CAP_SYS_MODULE
AmbientCapabilities=CAP_SYS_MODULE
Type=oneshot
RemainAfterExit=yes
ExecStart=modprobe -a tz_log qcom_tsens

[Install]
WantedBy=multi-user.target

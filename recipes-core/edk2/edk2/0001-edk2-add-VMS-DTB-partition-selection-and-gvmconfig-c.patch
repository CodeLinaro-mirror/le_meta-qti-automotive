 	BootStats.c
diff --git a/QcomModulePkg/Library/BootLib/LocateDeviceTree.c b/QcomModulePkg/Library/BootLib/LocateDeviceTree.c
index a85ae528a0..85635f4df8 100644
--- a/QcomModulePkg/Library/BootLib/LocateDeviceTree.c
+++ b/QcomModulePkg/Library/BootLib/LocateDeviceTree.c
@@ -38,6 +38,9 @@
 #include <Library/BootLinux.h>
 #include <Library/PartitionTableUpdate.h>
 #include <Library/Rtic.h>
+#ifdef VMS_BOOT_MODE
+#include <Library/VmsDtbLayout.h>
+#endif
 // Variables to initialize board data
 
 STATIC int
@@ -667,6 +670,27 @@ DeviceTreeAppended (VOID *kernel,
   if (((uintptr_t)kernel + (uintptr_t)dtb_offset) < (uintptr_t)kernel) {
     goto out;
   }
+
+#ifdef VMS_BOOT_MODE
+  {
+    UINT32     VmsPartOffset = 0;
+    EFI_STATUS VmsStatus;
+
+    VmsStatus = GetVmsDtbPartitionOffset (
+                    kernel,
+                    dtb_offset,
+                    (uintptr_t)kernel_end,
+                    &VmsPartOffset);
+
+    if (VmsStatus == EFI_SUCCESS) {
+      DEBUG ((EFI_D_INFO, "DeviceTreeAppended: VMS offset=0x%x\n", VmsPartOffset));
+      dtb_offset += VmsPartOffset;
+    } else {
+      DEBUG ((EFI_D_VERBOSE, "DeviceTreeAppended: no vms-header, plain dtb.img\n"));
+    }
+  }
+#endif /* VMS_BOOT_MODE */
+
   dtb = kernel + dtb_offset;
   while (((uintptr_t)dtb + sizeof (struct fdt_header)) <
          (uintptr_t)kernel_end) {
@@ -707,6 +731,15 @@ DeviceTreeAppended (VOID *kernel,
             best_match_dt_entry->pmic_rev[0], best_match_dt_entry->pmic_rev[1],
             best_match_dt_entry->pmic_rev[2], best_match_dt_entry->pmic_rev[3],
             best_match_dt_entry->offset, best_match_dt_entry->size));
+
+#ifdef VMS_BOOT_MODE
+    DEBUG ((EFI_D_INFO,
+            "DeviceTreeAppended: best match VMS idx=%d offset=0x%x size=0x%x\n",
+            best_match_dt_entry->Idx - 1,
+            (UINT32)(best_match_dt_entry->offset - (UINT64)(uintptr_t)kernel) - dtb_offset,
+            best_match_dt_entry->size));
+#endif
+
     DEBUG ((EFI_D_INFO, "Using pmic info 0x%0x/0x%x/0x%x/0x%0x for device "
                         "0x%0x/0x%x/0x%x/0x%0x\n",
             best_match_dt_entry->pmic_rev[0], best_match_dt_entry->pmic_rev[1],
@@ -1246,6 +1279,27 @@ GetSocDtb (VOID *Kernel, UINT32 KernelSize, UINT32 DtbOffset, VOID *DtbLoadAddr)
   if (((uintptr_t)Kernel + (uintptr_t)DtbOffset) < (uintptr_t)Kernel) {
     return NULL;
   }
+
+#ifdef VMS_BOOT_MODE
+  {
+    UINT32     VmsPartOffset = 0;
+    EFI_STATUS VmsStatus;
+
+    VmsStatus = GetVmsDtbPartitionOffset (
+                    Kernel,
+                    DtbOffset,
+                    KernelEnd,
+                    &VmsPartOffset);
+
+    if (VmsStatus == EFI_SUCCESS) {
+      DEBUG ((EFI_D_INFO, "GetSocDtb: VMS offset=0x%x\n", VmsPartOffset));
+      DtbOffset += VmsPartOffset;
+    } else {
+      DEBUG ((EFI_D_VERBOSE, "GetSocDtb: no vms-header, plain dtb.img\n"));
+    }
+  }
+#endif /* VMS_BOOT_MODE */
+
   Dtb = Kernel + DtbOffset;
   while (((uintptr_t)Dtb + sizeof (struct fdt_header)) < (uintptr_t)KernelEnd) {
     /* the DTB could be unaligned, so extract the header,
@@ -1289,6 +1343,14 @@ GetSocDtb (VOID *Kernel, UINT32 KernelSize, UINT32 DtbOffset, VOID *DtbLoadAddr)
     return NULL;
   }
 
+#ifdef VMS_BOOT_MODE
+  DEBUG ((EFI_D_INFO,
+          "GetSocDtb: best match VMS osconfig=%a idx=%d offset=0x%x size=0x%x\n",
+          VmsOsConfigValue, DtbIdx,
+          (UINT32)((uintptr_t)BestDtbInfo.Dtb - (uintptr_t)Kernel) - DtbOffset,
+          (UINT32)fdt_totalsize (BestDtbInfo.Dtb)));
+#endif
+
   return BestDtbInfo.Dtb;
 }
 

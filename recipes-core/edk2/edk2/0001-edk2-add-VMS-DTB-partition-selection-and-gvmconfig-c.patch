diff --git a/QcomModulePkg/Library/BootLib/VmsDtbLayout.c b/QcomModulePkg/Library/BootLib/VmsDtbLayout.c
new file mode 100644
index 0000000000..fa254a7116
--- /dev/null
+++ b/QcomModulePkg/Library/BootLib/VmsDtbLayout.c
@@ -0,0 +1,146 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ *
+ * VmsDtbLayout.c - VMS DTB partition selection from dtb.img.
+ */
+
+#include <Library/DebugLib.h>
+#include <Library/LocateDeviceTree.h>
+#include "UpdateDeviceTree.h"
+#include <Library/VmsDtbLayout.h>
+#if defined(VMS_BOOT_MODE)
+#include <Library/Board.h>
+#include <Protocol/EFISoftSKU.h>
+#endif
+
+CONST CHAR8 *VmsOsConfigValue = NULL;
+
+#if defined(VMS_BOOT_MODE)
+/* SoftSKU OS_CFG index -> osconfig string. Must match OsConfigs[] in
+ * UpdateCmdLine.c so the sku ABL (VMS_BOOT_MODE=0) selects the DTB
+ * partition matching the fused OS configuration. */
+STATIC CONST CHAR8 *VmsSkuOsConfigs[] = {
+  "PVM+GVM", "PVMOnly", "PVM+2GVM",
+};
+#endif
+
+/* Read a 64-bit big-endian property (two u32 cells). Returns 0 if absent. */
+STATIC UINT64
+ReadU64Prop (
+  IN CONST VOID  *Fdt,
+  IN INT32        NodeOffset,
+  IN CONST CHAR8 *PropName
+  )
+{
+  INT32        Len = 0;
+  CONST UINT32 *Prop;
+
+  Prop = fdt_getprop (Fdt, NodeOffset, PropName, &Len);
+  if (!Prop || Len != (INT32)(2 * sizeof (UINT32))) {
+    return 0;
+  }
+  return ((UINT64)fdt32_to_cpu (Prop[0]) << 32) |
+          (UINT64)fdt32_to_cpu (Prop[1]);
+}
+
+EFI_STATUS
+GetVmsDtbPartitionOffset (
+  IN  VOID        *DtbBase,
+  IN  UINT32       DtbOffset,
+  IN  uintptr_t    KernelEnd,
+  OUT UINT32       *PartOffset
+  )
+{
+  VOID               *DtbSection;
+  struct fdt_header   Hdr;
+  UINT32              HdrSize;
+  INT32               LayoutNode;
+  UINT64              Offset;
+  CONST CHAR8        *PropName;
+  UINTN               Idx;
+  UINTN               NumEntries;
+
+  if (!DtbBase || !PartOffset) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+#if defined(VMS_BOOT_MODE)
+  /* DeviceTreeAppended() runs before UpdateCmdLine() sets VmsOsConfigValue,
+   * so resolve the boot mode here as a fallback to avoid defaulting to the
+   * pvm partition. */
+  if (VmsOsConfigValue == NULL) {
+    if (VMS_BOOT_MODE > 0) {
+      /* Forced mode: use the compile-time VMS_BOOT_MODE. */
+      VmsOsConfigValue = VmsOsConfigMap[VMS_BOOT_MODE - 1][0];
+    } else if (IsSoftSkuProtocolAvailable) {
+      /* SKU (auto) mode: read the fused OS config and map it to an
+       * osconfig string, mirroring UpdateCmdLine()'s OsConfigs[]. */
+      UINT32     SkuParam = 0;
+      EFI_STATUS SkuStatus;
+
+      SkuStatus = GetSoftSKUFeatureInfo (SOFT_SKU_SWCFG_OS_CFG, &SkuParam);
+      if (SkuStatus == EFI_SUCCESS &&
+          SkuParam < (sizeof (VmsSkuOsConfigs) / sizeof (VmsSkuOsConfigs[0]))) {
+        VmsOsConfigValue = VmsSkuOsConfigs[SkuParam];
+      }
+    }
+  }
+#endif
+
+  /* Find PropName by matching VmsOsConfigValue against VmsOsConfigMap[][0] */
+  PropName   = NULL;
+  NumEntries = sizeof (VmsOsConfigMap) / sizeof (VmsOsConfigMap[0]);
+  if (VmsOsConfigValue != NULL) {
+    for (Idx = 0; Idx < NumEntries; Idx++) {
+      if (AsciiStrCmp (VmsOsConfigValue, VmsOsConfigMap[Idx][0]) == 0) {
+        PropName = VmsOsConfigMap[Idx][1];
+        break;
+      }
+    }
+  }
+  if (PropName == NULL) {
+    return EFI_UNSUPPORTED;
+  }
+
+  DtbSection = (VOID *)((uintptr_t)DtbBase + DtbOffset);
+
+  if ((uintptr_t)DtbSection + sizeof (struct fdt_header) >= KernelEnd) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  gBS->CopyMem (&Hdr, DtbSection, sizeof (struct fdt_header));
+
+  if (fdt_check_header ((CONST VOID *)&Hdr) != 0 ||
+      fdt_check_header_ext ((VOID *)&Hdr) != 0) {
+    return EFI_NOT_FOUND;
+  }
+
+  HdrSize = fdt_totalsize ((CONST VOID *)&Hdr);
+
+  if ((uintptr_t)DtbSection + HdrSize > KernelEnd) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (fdt_node_check_compatible (DtbSection, 0, VMS_DTB_HEADER_COMPATIBLE) != 0) {
+    return EFI_NOT_FOUND;
+  }
+
+  LayoutNode = fdt_path_offset (DtbSection, VMS_DTB_LAYOUT_NODE);
+  if (LayoutNode < 0) {
+    return EFI_NOT_FOUND;
+  }
+
+  Offset = ReadU64Prop (DtbSection, LayoutNode, PropName);
+
+  if (Offset == 0) {
+    return EFI_UNSUPPORTED;
+  }
+
+  if (Offset > (UINT64)(KernelEnd - (uintptr_t)DtbBase - DtbOffset)) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  *PartOffset = (UINT32)Offset;
+
+  return EFI_SUCCESS;
+}

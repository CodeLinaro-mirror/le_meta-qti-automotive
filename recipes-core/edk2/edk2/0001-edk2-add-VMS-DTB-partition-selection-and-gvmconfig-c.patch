From 40544cbbceb452d934cdd2e4ee9a280582bfca0d Mon Sep 17 00:00:00 2001
From: Yimin Peng <yiminp@qti.qualcomm.com>
Date: Sat, 11 Jul 2026 18:33:40 +0530
Subject: [PATCH] edk2: add VMS DTB partition selection via osconfig

Add VMS boot support when VMS_BOOT_MODE is defined:

VmsDtbLayout.h / VmsDtbLayout.c:
- VmsOsConfigMap[][2]: {osconfig, prop_name} pairs for partition selection
- VmsOsConfigValue: resolved osconfig string set by UpdateCmdLine()
- GetVmsDtbPartitionOffset(): match VmsOsConfigValue against map to
  read partition offset from vms-header.dtb; EFI_NOT_FOUND if absent

UpdateCmdLine.c:
- VMS_BOOT_MODE=0: use SoftSKU osconfig, set VmsOsConfigValue
- VMS_BOOT_MODE>0: use VmsOsConfigMap[VMS_BOOT_MODE-1][0] directly

LocateDeviceTree.c:
- Call GetVmsDtbPartitionOffset() to advance dtb_offset to VMS partition

Change-Id: Iddda0d9808259b04482e215f8ccce1899a8cac6d
Signed-off-by: Yimin Peng <yiminp@qti.qualcomm.com>
---
 QcomModulePkg/Include/Library/VmsDtbLayout.h  |  48 ++++++
 QcomModulePkg/Library/BootLib/BootLib.inf     |   1 +
 .../Library/BootLib/LocateDeviceTree.c        |  62 ++++++++
 QcomModulePkg/Library/BootLib/UpdateCmdLine.c |  14 ++
 QcomModulePkg/Library/BootLib/VmsDtbLayout.c  | 146 ++++++++++++++++++
 QcomModulePkg/QcomModulePkg.dsc               |   3 +
 makefile                                      |   1 +
 7 files changed, 275 insertions(+)
 create mode 100644 QcomModulePkg/Include/Library/VmsDtbLayout.h
 create mode 100644 QcomModulePkg/Library/BootLib/VmsDtbLayout.c

diff --git a/QcomModulePkg/Include/Library/VmsDtbLayout.h b/QcomModulePkg/Include/Library/VmsDtbLayout.h
new file mode 100644
index 0000000000..393fdb5d51
--- /dev/null
+++ b/QcomModulePkg/Include/Library/VmsDtbLayout.h
@@ -0,0 +1,48 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ *
+ * VmsDtbLayout.h - VMS DTB partition selection from dtb.img.
+ *
+ * dtb.img layout:
+ *   [vms-header.dtb][pvm dtbs][64B pad][lagvm dtbs][64B pad][mgvm dtbs]...
+ *
+ * vms-header.dtb /vms-dtb-layout carries the byte offset of each partition
+ * (0 = absent). VmsOsConfigValue selects the partition via VmsOsConfigMap[].
+ */
+
+#ifndef __VMS_DTB_LAYOUT_H__
+#define __VMS_DTB_LAYOUT_H__
+
+#include <Uefi.h>
+
+#define VMS_DTB_HEADER_COMPATIBLE  "qcom,vms-dtb-header"
+#define VMS_DTB_LAYOUT_NODE        "/vms-dtb-layout"
+
+/* {osconfig_value, partition_offset_prop} mapping table */
+STATIC CONST CHAR8 *VmsOsConfigMap[][2] = {
+  { "PVMOnly",    "pvm-offset"    },
+  { "PVM+GVM",    "lagvm-offset"  },
+  { "PVM+2GVM",   "mgvm-offset"   },
+  { "PVM+QCLGVM", "qclgvm-offset" },
+};
+
+/* Set by UpdateCmdLine() to the resolved osconfig string (e.g. "PVM+GVM").
+ * Used by GetVmsDtbPartitionOffset() to select the DTB partition. */
+extern CONST CHAR8 *VmsOsConfigValue;
+
+/*
+ * GetVmsDtbPartitionOffset - select DTB partition from dtb.img.
+ *
+ * Reads vms-header.dtb at DtbBase+DtbOffset; matches VmsOsConfigValue
+ * against VmsOsConfigMap[][0] to find the partition offset property.
+ * Returns EFI_NOT_FOUND if no vms-header (plain dtb.img).
+ */
+EFI_STATUS
+GetVmsDtbPartitionOffset (
+  IN  VOID        *DtbBase,
+  IN  UINT32       DtbOffset,
+  IN  uintptr_t    KernelEnd,
+  OUT UINT32       *PartOffset
+  );
+
+#endif /* __VMS_DTB_LAYOUT_H__ */

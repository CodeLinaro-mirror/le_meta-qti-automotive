From 4efbf0fff5542c64e7dcd6f63a20b990d51aecef Mon Sep 17 00:00:00 2001
From: Zhuo Yang <zhuyan@qti.qualcomm.com>
Date: Sun, 23 Aug 2026 16:37:43 +0800
Subject: [PATCH] abl: support append cmdline by makefile variable

PVM+QCLGVM cannot be selected via the SoftSKU protocol since the
fuse-backed OS Config field only enumerates PVM+GVM, PVMOnly and
PVM+2GVM. Add a build-time-only macro, QCLGVM_OS_CFG, that hardcodes
the OS Config nibble to the value passed on the command line instead
of querying SoftSKU, so a dedicated ABL variant can always resolve to
the qclgvm configuration regardless of fuse state. Product Config is
unaffected and keeps querying SoftSKU normally.

When QCLGVM_OS_CFG is defined, OsConfigs[] gains a fourth entry,
"PVM+QCLGVM", and the osconfig= cmdline parameter reports it without
querying SoftSKU. Builds that do not define the macro are unchanged.

Change-Id: Ic1e5b35cd65af4608bb472ebccdbdf01668d0f0d
Signed-off-by: Zhuo Yang <zhuyan@qti.qualcomm.com>
---
 QcomModulePkg/Include/Library/Board.h         |  6 ++++++
 QcomModulePkg/Library/BootLib/Board.c         |  4 ++++
 QcomModulePkg/Library/BootLib/UpdateCmdLine.c | 11 ++++++++++-
 QcomModulePkg/QcomModulePkg.dsc               |  3 +++
 makefile                                      |  1 +
 5 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/QcomModulePkg/Include/Library/Board.h b/QcomModulePkg/Include/Library/Board.h
index ecb14e2a01..be03086f82 100644
--- a/QcomModulePkg/Include/Library/Board.h
+++ b/QcomModulePkg/Include/Library/Board.h
@@ -139,6 +139,12 @@ struct BoardInfo {
 #define SOFTSKU_ID_PROD_CONFIG_SHIFT  8
 #define SOFTSKU_ID_PROD_CONFIG_MASK  (0xf << SOFTSKU_ID_PROD_CONFIG_SHIFT)
 
+/* QCLGVM_OS_CFG (build-time only): hardcode OS Config to this value
+   instead of querying SoftSKU, for the dedicated qclgvm ABL variant. */
+#ifdef QCLGVM_OS_CFG
+#define QCLGVM_OS_CONFIG_ID  QCLGVM_OS_CFG
+#endif
+
 extern BOOLEAN IsSoftSkuProtocolAvailable;
 
 EFI_STATUS
diff --git a/QcomModulePkg/Library/BootLib/Board.c b/QcomModulePkg/Library/BootLib/Board.c
index 35378f2a4e..86c101001d 100644
--- a/QcomModulePkg/Library/BootLib/Board.c
+++ b/QcomModulePkg/Library/BootLib/Board.c
@@ -564,12 +564,16 @@ VOID BoardSoftSKU (UINT32 *SKUId)
     return;
   }
 
+#ifdef QCLGVM_OS_CFG
+  OsConfig = QCLGVM_OS_CONFIG_ID;
+#else
   Status = GetSoftSKUFeatureInfo(SOFT_SKU_SWCFG_OS_CFG, &OsConfig);
   if (Status != EFI_SUCCESS) {
     DEBUG ((EFI_D_ERROR, "Failed to get OS Config Data\n"));
     OsConfig = BAD_SOFTSKU_ID;
     return;
   }
+#endif
 
   *SKUId = ((OsConfig << SOFTSKU_ID_OS_CONFIG_SHIFT) |
 		  (ProdConfig << SOFTSKU_ID_PROD_CONFIG_SHIFT));
diff --git a/QcomModulePkg/Library/BootLib/UpdateCmdLine.c b/QcomModulePkg/Library/BootLib/UpdateCmdLine.c
index 7abea27782..bad67a5422 100644
--- a/QcomModulePkg/Library/BootLib/UpdateCmdLine.c
+++ b/QcomModulePkg/Library/BootLib/UpdateCmdLine.c
@@ -128,7 +128,11 @@ STATIC CONST CHAR8 *ProdConfigs[] = {
    "non-safe-ivi", "adas", "safe-ivi", "flex", };
 STATIC CHAR8 *SltFlavorCmdLine = " sltflavor=1";
 STATIC CONST CHAR8 *OsConfigs[] = {
-   "PVM+GVM", "PVMOnly", "PVM+2GVM", };
+   "PVM+GVM", "PVMOnly", "PVM+2GVM",
+#ifdef QCLGVM_OS_CFG
+   "PVM+QCLGVM",
+#endif
+   };
 #ifdef SOC_OP_MODE_IN_CMDLINE
 STATIC CHAR8 SocOpModeCmdLine[SOC_OP_MODE_MAX_LEN];
 STATIC CONST CHAR8 *SocOpModes[] = {
@@ -1713,7 +1717,12 @@ UpdateCmdLine (BootParamlist *BootParamlistPtr,
       DEBUG ((EFI_D_INFO, "Failed to get SLT flavor info\n"));
     }
 
+#ifdef QCLGVM_OS_CFG
+    SkuParam = ARRAY_SIZE (OsConfigs) - 1;
+    Status = EFI_SUCCESS;
+#else
     Status = GetSoftSKUFeatureInfo (SOFT_SKU_SWCFG_OS_CFG, &SkuParam);
+#endif
     if (Status == EFI_SUCCESS) {
       AsciiSPrint (OsConfigCmdLine, sizeof (OsConfigCmdLine), " osconfig=%a",
                    OsConfigs[SkuParam]);
diff --git a/QcomModulePkg/QcomModulePkg.dsc b/QcomModulePkg/QcomModulePkg.dsc
index e7a4b6401e..5b87f22431 100644
--- a/QcomModulePkg/QcomModulePkg.dsc
+++ b/QcomModulePkg/QcomModulePkg.dsc
@@ -226,6 +226,9 @@
   !if $(FLASHING_LOCK_WITHOUT_MISC_PART) == 1
       GCC:*_*_*_CC_FLAGS = -DFLASHING_LOCK_WITHOUT_MISC_PART
   !endif
+  !ifdef $(QCLGVM_OS_CFG)
+      GCC:*_*_*_CC_FLAGS = -DQCLGVM_OS_CFG=$(QCLGVM_OS_CFG)
+  !endif
 
 [PcdsFixedAtBuild.common]
 
diff --git a/makefile b/makefile
index c38dbe05dd..eaaa93a505 100644
--- a/makefile
+++ b/makefile
@@ -398,6 +398,7 @@ ABL_FV_IMG: $(EDK_TOOLS_PATH_MARK_FILE)
 	-D QSPA_BOOTCONFIG_ENABLE=$(QSPA_BOOTCONFIG_ENABLE) \
 	-D SOC_OP_MODE_IN_CMDLINE=$(SOC_OP_MODE_IN_CMDLINE) \
 	-D FLASHING_LOCK_WITHOUT_MISC_PART=$(FLASHING_LOCK_WITHOUT_MISC_PART) \
+	$(if $(QCLGVM_OS_CFG),-D QCLGVM_OS_CFG=$(QCLGVM_OS_CFG)) \
 	-j build_modulepkg.log $*
 
 	cp $(BUILD_ROOT)/FV/FVMAIN_COMPACT.Fv $(ABL_FV_IMG)
-- 
